# Salin ke .env lalu isi nilainya (JANGAN commit .env asli)
DATABASE_URL=postgresql://venue_admin:PASSWORD@127.0.0.1:5432/venue_system
FLASK_APP=wsgi.py
SECRET_KEY=ganti-dengan-string-acak-64-hex
JWT_SECRET_KEY=ganti-dengan-string-acak-64-hex
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30
CORS_ORIGINS=https://portal.aspsports.id

# --- AI (fitur Ask AI & briefing Radar) ---
# Dapatkan key dari console.anthropic.com (bentuk sk-ant-...). Kalau kosong,
# fitur AI mati (endpoint balas 503 "belum dikonfigurasi") — bagian sistem lain
# TIDAK terpengaruh. Radar Operasional tetap jalan tanpa key ini.
ANTHROPIC_API_KEY=
# Opsional: ganti model tanpa ubah kode (mis. model murah utk hemat biaya).
# Kosongkan/hapus baris ini untuk pakai default.
ANTHROPIC_MODEL=claude-opus-4-8
